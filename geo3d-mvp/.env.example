# Скопируйте в .env (файл .env в git не попадает) и заполните.

# Пароль админки. Обязательно смените, «admin» допустим только локально.
ADMIN_PASSWORD=

# Оплата: free (по умолчанию: пробный период, отчёты бесплатно) | demo (показ без денег) | live (боевой режим) | off (отчёты не выдаются)
PAYMENT_MODE=free

# Боевой режим. Ссылка на страницу оплаты у вашего платёжного провайдера (Kaspi Pay / Halyk epay / Freedom Pay).
# Подстановки: {orderId} {amount} {returnUrl}
PAYMENT_URL_TEMPLATE=
# Общий секрет для проверки подписи вебхука (задаёте вы и вносите в кабинет провайдера)
PAYMENT_WEBHOOK_SECRET=

# Публичный адрес сайта (для возврата после оплаты)
PUBLIC_URL=https://example.kz

# 1 — если сервер стоит за nginx/Caddy
TRUST_PROXY=0
PORT=8095

# PostgreSQL/PostGIS (этап миграции, docs/MIGRATION.md). Supabase: Project Settings → Database → Connection string (URI).
# Для импорта лучше прямое подключение или Session pooler (порт 5432), не Transaction pooler.
DATABASE_URL=
