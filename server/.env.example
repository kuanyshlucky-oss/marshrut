# Пример переменных окружения. Скопируйте в .env для локального запуска.

# Порт, на котором слушает сервер
PORT=8080

# Строка подключения к Postgres (например, от Neon) — обязательна
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Секрет для подписи токенов — ОБЯЗАТЕЛЕН всегда, сервер не запустится без него
# (без дефолтного значения намеренно: раньше при отсутствующей переменной
# использовалось общеизвестное значение по умолчанию — это позволило бы
# подделать токен авторизации). Сгенерировать: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Ключ для доступа к /api/admin/* — обязательно задайте свой на проде.
# Пусто = админ-эндпоинты полностью отключены.
ADMIN_KEY=change-me-to-a-long-random-string

# Необязательно: список IP через запятую, с которых разрешён доступ к /api/admin/*
# (в дополнение к ADMIN_KEY). Пусто = ограничение по IP выключено.
ADMIN_ALLOWED_IPS=

# Домен фронтенда для CORS (в проде — адрес GitHub Pages).
# Для локальной разработки можно оставить *
ALLOWED_ORIGIN=https://kuanyshlucky-oss.github.io

# --- WhatsApp Cloud API (Meta), напрямую, без BSP-посредника ---
# См. server/README.md, раздел "WhatsApp".

# Придумайте сами — этот же токен вводится в настройках вебхука в Meta.
WA_VERIFY_TOKEN=change-me-to-a-long-random-string
# Постоянный токен системного пользователя из Meta Business Manager (или временный на 24ч для теста).
WA_ACCESS_TOKEN=
# Phone Number ID (НЕ сам номер телефона) — из App Dashboard → WhatsApp → API Setup.
WA_PHONE_NUMBER_ID=
# App Secret приложения Meta — нужен для проверки подписи входящих вебхуков.
# Пусто = проверка подписи выключена (не рекомендуется на проде).
WA_APP_SECRET=
# Версия Graph API (менять обычно не нужно).
WA_GRAPH_VERSION=v21.0
