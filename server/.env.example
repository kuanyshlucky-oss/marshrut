# Пример переменных окружения. Скопируйте в .env для локального запуска.

# Порт, на котором слушает сервер
PORT=8080

# Строка подключения к Postgres (например, от Neon) — обязательна
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Секрет для подписи токенов — ОБЯЗАТЕЛЕН, минимум 16 символов (рекомендуется 32+);
# сервер не запустится без него
# (без дефолтного значения намеренно: раньше при отсутствующей переменной
# использовалось общеизвестное значение по умолчанию — это позволило бы
# подделать токен авторизации). Сгенерировать: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Ключ для доступа к /api/admin/* — задайте свой на проде, минимум 16 символов.
# Пусто = админ-эндпоинты полностью отключены.
ADMIN_KEY=change-me-to-a-long-random-string

# Необязательно: список IP через запятую, с которых разрешён доступ к /api/admin/*
# (в дополнение к ADMIN_KEY). Пусто = ограничение по IP выключено.
ADMIN_ALLOWED_IPS=

# Домен фронтенда для CORS (в проде — адрес GitHub Pages).
# Для локальной разработки можно оставить *
ALLOWED_ORIGIN=https://kuanyshlucky-oss.github.io

# Сколько прокси перед сервером дописывает X-Forwarded-For (Render — 1).
# IP клиента берётся справа; 0 = прокси нет, заголовку не верить.
TRUSTED_PROXY_HOPS=1

# Размер пула соединений с БД (Neon free ограничивает число соединений).
DB_MAX_CONNS=5

# Сколько секунд кэшировать session_id в памяти (0 = выключить кэш).
# Вход/выход на этом же инстансе сбрасывают кэш сразу; при нескольких
# инстансах отзыв сессии на другом виден не позже этого срока.
SESSION_CACHE_TTL_SEC=15

# Формат логов: json (по умолчанию, для сбора логов) или text (для разработки).
LOG_FORMAT=json
